      </ReferencePath>
      <ReferencePath Include="$(MSBuildProjectDirectory)\lib\Microsoft.Office.Tools.v4.0.Framework.dll">
        <Private>False</Private>
        <FusionName>Microsoft.Office.Tools.v4.0.Framework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a</FusionName>
      </ReferencePath>
      <ReferencePath Include="$(MSBuildProjectDirectory)\lib\Microsoft.VisualStudio.Tools.Applications.Runtime.dll">
        <Private>False</Private>
        <FusionName>Microsoft.VisualStudio.Tools.Applications.Runtime, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a</FusionName>
      </ReferencePath>
      <!-- Microsoft.Office.Core interop assembly (required by VSTO types) -->
      <ReferencePath Include="$(MSBuildProjectDirectory)\lib\Microsoft.Office.Core.dll" Condition="Exists('$(MSBuildProjectDirectory)\lib\Microsoft.Office.Core.dll')">
        <EmbedInteropTypes>True</EmbedInteropTypes>
        <Private>False</Private>
      </ReferencePath>
    </ItemGroup>
    <Message Importance="high" Text="[VSTO-FORCE] Injected VSTO refs. ReferencePath now has @(ReferencePath->Count()) items:" />
    <Message Importance="high" Text="  %(ReferencePath.Identity)" />
  </Target>
