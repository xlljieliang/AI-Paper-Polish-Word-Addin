  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Office\Microsoft.VisualStudio.Tools.Office.targets" />
  <!-- Force VSTO reference assemblies into C# compiler input.
       Runs AFTER ResolveAssemblyReferences but BEFORE CoreCompile (CSC).
       This bypasses MSBuild's reference resolution which fails on CI due to
